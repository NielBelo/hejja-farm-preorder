{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hejja-farm-preorder-test",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "hejja-okofarm.hu/*",
      "custom_domain": false
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hejja-farm-preorder-test"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MAINTENANCE_KV",
      "id": "7c1892cdf9144983a297ff043c29dba7",
      "preview_id": "9b4861ac003940a78822c629e366acf0"
    }
  ]
}
